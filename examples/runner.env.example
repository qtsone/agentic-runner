# Copy to runner.env next to compose.yaml and fill in the control plane URL and the token
# (docs/docker.md). Keep the file readable by you only: `chmod 600 runner.env`.

# The control plane's public Runner edge, from the Organisation Console's Runners page.
AGENTIC_CONTROL_PLANE_URL=https://api.agentic.<zone>
# The Runner takes its Temporal address from its registration. Set this only for a control
# plane that does not send one.
# TEMPORAL_ADDRESS=temporal-grpc.<zone>:443
AGENTIC_TEMPORAL_TLS=true

# The Runner Registration Token your Organisation's Admin issued, shown once. The Runner
# needs it only for its first start, when it exchanges it for its own identity on the state
# volume: delete this line once the Runner shows on the Runners page.
AGENTIC_RUNNER_REGISTRATION_TOKEN=

# The Organisation's Pool Key, shown once on the Runners page, for a Runner of the
# Organisation's pool that opens its LLM Keys. Unlike the token, keep this line: the Runner
# reads it on every start and holds it in memory only.
# AGENTIC_RUNNER_POOL_KEY=

# Free-form Runner Tags, used for routing: key=value,key=value.
# AGENTIC_RUNNER_TAGS=region=eu-west-1

# The container is the Agent Runtime's sandbox. Both runtimes refuse to run a Directive
# until the deployment says so explicitly; leave these as they are.
CODEX_SANDBOX_MODE=danger-full-access
CODEX_ASK_FOR_APPROVAL=never
CODEX_STRICT_CONFIG=true
CODEX_POLICY_HOOK_CONFIGURED=true
CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true
